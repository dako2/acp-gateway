{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/acp/checkout-response.schema.json",
  "title": "ACP Checkout Response",
  "description": "Gateway response to checkout request - aligned with official ACP specification",
  "type": "object",
  "required": ["ok", "sandbox"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "Whether the checkout was created successfully"
    },
    "sandbox": {
      "type": "boolean",
      "description": "Whether this was processed in sandbox mode"
    },
    "order_id": {
      "type": "string",
      "description": "Unique order identifier"
    },
    "checkout_id": {
      "type": "string",
      "description": "Checkout session identifier"
    },
    "payment_intent_status": {
      "type": "string",
      "enum": ["requires_action", "succeeded", "failed", "canceled"],
      "description": "Status of the payment intent"
    },
    "redirect_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to redirect user for payment completion"
    },
    "client_secret": {
      "type": "string",
      "description": "Client secret for frontend payment confirmation"
    },
    "total": {
      "$ref": "#/$defs/Money",
      "description": "Total amount for the order"
    },
    "error": {
      "type": "string",
      "description": "Error message if ok is false"
    }
  },
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "currency"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "Monetary value"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Three-letter currency code (ISO 4217)"
        }
      }
    }
  }
}
