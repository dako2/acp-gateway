{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/acp/checkout.schema.json",
  "title": "ACP Checkout Request",
  "description": "Request to create a checkout session - aligned with official ACP specification",
  "type": "object",
  "required": ["cart_id"],
  "properties": {
    "cart_id": {
      "type": "string",
      "description": "ID of the cart to checkout"
    },
    "buyer": {
      "$ref": "#/$defs/Buyer",
      "description": "Buyer information"
    },
    "shipping_address": {
      "$ref": "#/$defs/Address"
    },
    "billing_address": {
      "$ref": "#/$defs/Address",
      "description": "Billing address (defaults to shipping_address if not provided)"
    },
    "payment": {
      "$ref": "#/$defs/Payment"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the checkout",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "line_one", "city", "state", "country", "postal_code"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the recipient"
        },
        "line_one": {
          "type": "string",
          "description": "Primary address line (street address)"
        },
        "line_two": {
          "type": "string",
          "description": "Secondary address line (apartment, suite, etc.)"
        },
        "city": {
          "type": "string",
          "description": "City name"
        },
        "state": {
          "type": "string",
          "description": "State or province"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Two-letter country code (ISO 3166-1 alpha-2)"
        },
        "postal_code": {
          "type": "string",
          "description": "Postal or ZIP code"
        }
      }
    },
    "Buyer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_name", "last_name", "email"],
      "properties": {
        "first_name": {
          "type": "string",
          "description": "Buyer's first name"
        },
        "last_name": {
          "type": "string",
          "description": "Buyer's last name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Buyer's email address"
        },
        "phone_number": {
          "type": "string",
          "description": "Buyer's phone number"
        }
      }
    },
    "Payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["card", "paypal", "apple_pay", "google_pay", "bank_transfer"],
          "description": "Payment method"
        },
        "token": {
          "type": "string",
          "description": "Payment token from payment processor"
        },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "number": {
              "type": "string",
              "description": "Card number"
            },
            "exp_month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "description": "Expiration month"
            },
            "exp_year": {
              "type": "integer",
              "minimum": 2024,
              "description": "Expiration year"
            },
            "cvc": {
              "type": "string",
              "description": "Card verification code"
            }
          }
        }
      }
    }
  }
}
