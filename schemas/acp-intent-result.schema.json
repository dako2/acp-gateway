{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/acp/intent-result.schema.json",
  "title": "ACP Intent Result",
  "description": "Gateway response to an LLM intent - aligned with official ACP specification",
  "type": "object",
  "required": ["type", "ok", "sandbox"],
  "properties": {
    "type": {
      "type": "string",
      "const": "acp.intent.result"
    },
    "ok": {
      "type": "boolean",
      "description": "Whether the intent was processed successfully"
    },
    "sandbox": {
      "type": "boolean",
      "description": "Whether this was processed in sandbox mode"
    },
    "cart": {
      "$ref": "#/$defs/Cart"
    },
    "next": {
      "$ref": "#/$defs/NextAction"
    },
    "error": {
      "type": "string",
      "description": "Error message if ok is false"
    }
  },
  "$defs": {
    "Cart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items", "subtotal"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique cart identifier"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CartItem"
          },
          "description": "Items in the cart"
        },
        "subtotal": {
          "$ref": "#/$defs/Money",
          "description": "Subtotal amount"
        },
        "total": {
          "$ref": "#/$defs/Money",
          "description": "Final total including taxes and shipping"
        },
        "taxes": {
          "$ref": "#/$defs/Money",
          "description": "Tax amount"
        },
        "shipping": {
          "$ref": "#/$defs/Money",
          "description": "Shipping cost"
        }
      }
    },
    "CartItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quantity", "price"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Product/item identifier"
        },
        "variant_id": {
          "type": "string",
          "description": "Variant identifier - ACP extension"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "description": "Quantity of the item"
        },
        "price": {
          "$ref": "#/$defs/Money",
          "description": "Price of the item"
        }
      }
    },
    "NextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "endpoint"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["checkout", "payment", "confirmation"],
          "description": "Next action to perform"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "description": "Endpoint URL for the next action"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE"],
          "default": "POST",
          "description": "HTTP method for the next action"
        },
        "params": {
          "type": "object",
          "description": "Additional parameters for the next action",
          "additionalProperties": true
        }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "currency"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "Monetary value"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Three-letter currency code (ISO 4217)"
        }
      }
    }
  }
}
