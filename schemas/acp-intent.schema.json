{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/acp/intent.schema.json",
  "title": "ACP Intent",
  "description": "LLM agent intent to perform commerce actions - aligned with official ACP specification",
  "type": "object",
  "required": ["type", "actor", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "const": "acp.intent"
    },
    "actor": {
      "type": "string",
      "const": "llm"
    },
    "payload": {
      "$ref": "#/$defs/IntentPayload"
    }
  },
  "$defs": {
    "IntentPayload": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["add_to_cart", "select_variant", "set_quantity", "checkout"],
          "description": "The action to perform"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          },
          "default": [],
          "description": "Items to act upon"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes from the LLM about user preferences or context"
        },
        "context": {
          "$ref": "#/$defs/IntentContext"
        }
      }
    },
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quantity"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the product/item"
        },
        "variant_id": {
          "type": "string",
          "description": "Optional variant identifier (size, color, etc.) - ACP extension"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "description": "Quantity of the item"
        },
        "price": {
          "$ref": "#/$defs/Money",
          "description": "Optional price override - ACP extension"
        }
      }
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "currency"],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "description": "Monetary value"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "USD",
          "description": "Three-letter currency code (ISO 4217)"
        }
      }
    },
    "IntentContext": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional context like session_id, locale, etc.",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Session identifier"
        },
        "locale": {
          "type": "string",
          "description": "Locale identifier (e.g., en-US)"
        },
        "user_id": {
          "type": "string",
          "description": "User identifier"
        }
      }
    }
  }
}
