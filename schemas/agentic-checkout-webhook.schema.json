{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agentic-checkout-webhook.schema.json",
  "title": "Agentic Checkout Webhook Events",
  "description": "Webhook events for order lifecycle management",
  "$defs": {
    "Refund": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["store_credit", "original_payment"]
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Total amount of money refunded"
        }
      },
      "required": ["type", "amount"]
    },
    "EventData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "order"
        },
        "checkout_session_id": {
          "type": "string",
          "description": "ID that identifies the checkout session that created this order"
        },
        "permalink_url": {
          "type": "string",
          "format": "uri",
          "description": "URL that points to the order"
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "manual_review",
            "confirmed",
            "canceled",
            "shipped",
            "fulfilled"
          ],
          "description": "Latest status of the order"
        },
        "refunds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Refund"
          },
          "description": "List of refunds issued for the order"
        }
      },
      "required": ["type", "checkout_session_id", "permalink_url", "status", "refunds"]
    },
    "WebhookEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["order_created", "order_updated"],
          "description": "Type of webhook event"
        },
        "data": {
          "$ref": "#/$defs/EventData",
          "description": "Webhook event data"
        }
      },
      "required": ["type", "data"]
    }
  }
}
